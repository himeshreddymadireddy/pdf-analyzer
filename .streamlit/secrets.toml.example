# Copy this file to .streamlit/secrets.toml and replace only the keys you use.
# Never commit .streamlit/secrets.toml. Values below are placeholders, not real keys.
# Session overrides entered in the UI take precedence over these values, which take
# precedence over same-named process environment variables.

ANTHROPIC_API_KEY = "your-anthropic-api-key"
DEEPSEEK_API_KEY = "your-deepseek-api-key"
OPENAI_API_KEY = "your-openai-api-key"
